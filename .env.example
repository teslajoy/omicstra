# backends are COHORT declarations now - projects/{id}/cohort.json:
#   compute_backend: mac | slurm | arc      where encoders run
#   model_backend:   anthropic | bedrock    which endpoint the loop calls
# both fail closed when absent.

# anthropic - routing = haiku/sonnet, synthesis = opus 4.8
ANTHROPIC_API_KEY=

# langsmith - observability only
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omicstra
LANGSMITH_TRACING=true
# cohort root - the security boundary AND the cohort selector.
# unset = use the in-repo registry default (projects/registry.json).
OMICSTRA_PROJECT_DIR=
