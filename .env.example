# compute backend: local | cloud | slurm
OMICSTRA_COMPUTE_BACKEND=local

# anthropic - routing = haiku/sonnet, synthesis = opus 4.8
ANTHROPIC_API_KEY=

# langsmith - observability only
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omicstra
LANGSMITH_TRACING=true
# cohort root - the security boundary AND the cohort selector.
# unset = use the in-repo registry default (projects/registry.json).
OMICSTRA_PROJECT_DIR=
