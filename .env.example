# backends are COHORT declarations now - projects/{id}/cohort.json:
#   compute_backend: mac | slurm | arc      where encoders run
#   model_backend:   anthropic | bedrock    which endpoint the loop calls
# both fail closed when absent.

# anthropic - routing = haiku/sonnet, synthesis = opus 4.8
ANTHROPIC_API_KEY=

# langsmith - observability only
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omicstra
LANGSMITH_TRACING=true
# cohort root - the security boundary AND the cohort selector.
# unset = use the in-repo registry default (projects/registry.json).
OMICSTRA_PROJECT_DIR=

# transport. stdio needs none of these.
#   OMICSTRA_TRANSPORT=stdio|http
#   OMICSTRA_HTTP_MOUNT=/mcp
#   OMICSTRA_HTTP_PORT=8000
#   OMICSTRA_HTTP_HOST  the hostname the server will be REACHED at. the transport
#                       refuses an unknown Host with 421 (DNS-rebinding protection,
#                       on by default and staying on). behind a gateway this is the
#                       GATEWAY's hostname, not the instance's.
#   REQUIRE_PROTOCOL_2026=0|1   refuse clients older than the 2026-07-28 revision
#   OMICSTRA_CHECKPOINT=memory|sqlite:<path>   http needs a durable one to resume
