    "original_st": {
      "name": "Spatial Transcriptomics (Stahl 2016, KTH / Spatial Transcriptomics AB)",
      "spot_diameter_um": 100,
      "spot_pitch_um": 150,
      "spots_per_array": 1934,
      "cells_per_spot": 200,
      "resolution_class": "spot",
      "transcriptome_scope": "whole_transcriptome",
      "same_section_as_image": true,
